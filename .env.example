# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for Production/Preview.

# Canonical site URL (used for metadata, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://xdevs.in

# Contact form email delivery via Resend (https://resend.com). [TBD]
# Without these, the form logs submissions in development and shows a
# "reach us on LinkedIn" message in production.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Verified sender on a domain you own in Resend, e.g. "THE xDEVS <noreply@xdevs.in>".
CONTACT_FROM_EMAIL=
